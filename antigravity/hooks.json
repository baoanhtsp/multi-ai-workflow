{
  "sync-agentapi-bridge": {
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File skills/claude-leader/scripts/save-agentapi-env.ps1",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File skills/claude-leader/scripts/save-agentapi-env.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
